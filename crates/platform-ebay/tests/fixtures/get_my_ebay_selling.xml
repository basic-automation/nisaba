        <ListingType>FixedPriceItem</ListingType>
        <ViewItemURL>https://www.ebay.com/itm/110512345678</ViewItemURL>
        <SellingStatus>
          <CurrentPrice currencyID="USD">48.00</CurrentPrice>
        </SellingStatus>
        <PictureDetails>
          <GalleryURL>https://images.example.test/pants-gallery.jpg</GalleryURL>
          <PictureURL>https://images.example.test/pants-front.jpg</PictureURL>
