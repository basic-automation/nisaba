        </SellingStatus>
        <PictureDetails>
          <PictureURL>https://images.example.test/cap.jpg</PictureURL>
        </PictureDetails>
      </Item>
      <Item>
        <ItemID>110511111111</ItemID>
        <Quantity>2</Quantity>
