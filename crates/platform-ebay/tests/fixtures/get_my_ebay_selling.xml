  <ActiveList>
    <PaginationResult>
      <TotalNumberOfEntries>3</TotalNumberOfEntries>
      <TotalNumberOfPages>1</TotalNumberOfPages>
    </PaginationResult>
    <ItemArray>
      <Item>
        <ItemID>110512345678</ItemID>
        <Title>Ripstop Field Pants — Medium</Title>
        <Description>&lt;p&gt;Six-pocket ripstop field pants.&lt;/p&gt;</Description>
        <Quantity>10</Quantity>
        <QuantitySold>3</QuantitySold>
