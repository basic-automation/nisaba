{
  "productName": "Nisaba",
  "version": "0.1.2",
  "identifier": "com.nisaba.app",
  "build": {
    "frontendDist": "../../frontend/.output/public",
    "devUrl": "http://localhost:3456",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run generate",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Nisaba - Inventory Sync",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/licenses/rust-licenses.json",
      "resources/licenses/npm-licenses.json"
    ],
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MTVGRDg5NTAxOTU2ODcKUldTSFZobFFpZjBWeGd2QVJsSE85bVhPTkpNTXFXd1pEWkJhSUk1WFVmUUZMVnIyRG1VazNzK28K",
      "endpoints": [
        "https://github.com/basic-automation/nisaba/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
