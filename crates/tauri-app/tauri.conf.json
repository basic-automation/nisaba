{
  "productName": "Nisaba",
  "version": "0.1.0",
  "identifier": "com.nisaba.app",
  "build": {
    "frontendDist": "../../frontend/.output/public",
    "devUrl": "http://localhost:3456",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run generate",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Nisaba - Inventory Sync",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://raw.githubusercontent.com/nicbudd/nisaba-releases/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
