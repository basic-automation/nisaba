{
  // Typechecks the template plugin against nisaba.d.ts (N-12.2).
  // Run from this directory:
  //   node ../../frontend/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json
  // (the repo's frontend workspace already vendors TypeScript).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["index.ts", "nisaba.d.ts"]
}
